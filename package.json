{
  "name": "roam-journal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/roam-build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "dev": "npm run build && wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-file-handler": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1"
  }
}
