{
  "name": "roam-journal-local",
  "main": "scripts/local-worker.mjs",
  "compatibility_date": "2026-11-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roam-journal-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "roam-journal-local"
    }
  ]
}
